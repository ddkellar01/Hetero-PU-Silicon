# ==============================================================================
# Hetero-PU-Silicon Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# ==============================================================================

# --- Application Core Settings ---
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8080
WORKER_THREADS=8

# --- Silicon Architecture Routing Switches ---
# Enable or disable workload routing across your six specialized silicon tiers
ENABLE_CPU_BACKEND=true
ENABLE_GPU_BACKEND=true
ENABLE_DPU_OFFLOAD=false
ENABLE_TPU_BACKEND=false
ENABLE_LPU_BACKEND=false
ENABLE_NPU_BACKEND=false

# --- Hardware Device Bindings & Endpoints ---
# Specify target device IDs, paths, or connection strings
GPU_DEVICE_IDS=0,1
TPU_NODE_ADDRESS=grpc://tpu-node-local:8470
DPU_INTERFACE_NAME=eth0
NPU_DEVICE_PATH=/dev/npu0
LPU_ENDPOINT=http://localhost:9090

# --- LLM Serving & Inference Parameters ---
DEFAULT_MODEL_PATH=/models/default-llm
QUANTIZATION_LEVEL=int4
MAX_BATCH_SIZE=64
INFERENCE_TIMEOUT_MS=3000
PARALLEL_EXECUTION_MODE=true

# --- External API Keys & Telemetry (Optional) ---
HUGGINGFACE_HUB_TOKEN=your_hf_token_here
WANDB_API_KEY=your_wandb_api_key_here
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Docker & Registry Metadata ---
DOCKER_REGISTRY=docker.io
IMAGE_TAG=latest
